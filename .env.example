# Request your API key here: https://steamcommunity.com/dev/apikey
STEAM_API_KEY=

# Get your Steam ID from your account settings: https://store.steampowered.com/account/
STEAM_ID=

# User name you use to log in.
STEAM_USER=

# Optional list of app IDs to skip.
SKIP_APPIDS=

# Max download rate in KBps. I've made it mandatory, feel free to remove the line that refers to this in the script.
STEAM_DOWNLOAD_THROTTLE=25000

# Empty folder where steamcmd will set up its files and credentials.
STEAMCMD_DATA_PATH=

# Empty folder where you want to store your library.
LIBRARY_PATH=

# Folder where you've put this script. The default value should work fine.
COMPOSE_PATH=./

